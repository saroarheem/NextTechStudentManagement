
@model Student

@{
    ViewData["Title"] = "Delete Student";
}

<style>
    .delete-page {
        width: 100%;
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .delete-card {
        background: #FFFFFF;
        border: 1px solid rgba(180, 72, 60, 0.35);
        border-left: 4px solid #B4483C;
        border-radius: 6px;
        padding: 2rem;
    }

    .delete-heading {
        margin: 0 0 0.75rem;
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #8F3830;
    }

    .delete-message {
        margin: 0 0 1.5rem;
        color: var(--slate);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .delete-divider {
        height: 1px;
        border: 0;
        background: #EFEBE1;
        margin: 1.5rem 0;
    }

    .student-info {
        display: grid;
        grid-template-columns: 120px 1fr;
        row-gap: 0.85rem;
        margin: 0;
    }

        .student-info dt {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--slate);
        }

        .student-info dd {
            margin: 0;
            font-size: 0.9rem;
            color: var(--ink);
            overflow-wrap: break-word;
        }

    .delete-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .btn-delete,
    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.55rem 1.15rem;
        border-radius: 4px;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn-delete {
        background: #B4483C;
        border: 1px solid #B4483C;
        color: #FFFFFF;
    }

        .btn-delete:hover {
            background: #8F3830;
            border-color: #8F3830;
        }

    .btn-cancel {
        background: #FFFFFF;
        border: 1px solid #DCD7CB;
        color: var(--slate);
    }

        .btn-cancel:hover {
            background: var(--parchment);
            border-color: #C9C2B4;
            color: var(--ink);
        }

    @@media (max-width: 600px) {
        .delete-page {
            margin: 1.25rem auto;
            padding: 0 1rem;
        }

        .delete-card {
            padding: 1.25rem;
        }

        .delete-heading {
            font-size: 1.4rem;
        }

        .student-info {
            grid-template-columns: 1fr;
            row-gap: 0.3rem;
        }

            .student-info dt {
                margin-top: 0.65rem;
            }

                .student-info dt:first-child {
                    margin-top: 0;
                }

        .delete-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-delete,
        .btn-cancel {
            width: 100%;
        }
    }
</style>

<div class="delete-page">

    <div class="delete-card">

        <h4 class="delete-heading">
            Delete Student
        </h4>

        <p class="delete-message">
            Are you sure you want to delete this student?
        </p>

        <hr class="delete-divider" />

        <dl class="student-info">

            <dt>ID:</dt>
            <dd>@Model.StudentId</dd>

            <dt>Name:</dt>
            <dd>@Model.FullName</dd>

        </dl>

    </div>

    <form asp-action="DeleteConfirmed"
          method="post"
          class="delete-actions">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn-delete">
            Delete
        </button>

        <a asp-action="Index" class="btn-cancel">
            Cancel
        </a>

    </form>

</div>

