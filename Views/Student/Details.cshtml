```cshtml
@model Student

@{
    ViewData["Title"] = "Student Details";
}

<style>
    .details-page {
        width: 100%;
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .details-heading {
        margin: 0 0 1.75rem;
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--ink);
    }

    .details-card {
        background: #FFFFFF;
        border: 1px solid #E7E2D6;
        border-radius: 6px;
        overflow: hidden;
    }

    .details-body {
        padding: 2rem;
    }

    .detail-row {
        display: flex;
        align-items: flex-start;
        padding: 0.85rem 0;
        border-bottom: 1px solid #EFEBE1;
    }

        .detail-row:first-child {
            padding-top: 0;
        }

        .detail-row:last-child {
            padding-bottom: 0;
            border-bottom: none;
        }

    .detail-label {
        flex: 0 0 150px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--slate);
    }

    .detail-value {
        flex: 1;
        font-size: 0.9rem;
        color: var(--ink);
        overflow-wrap: break-word;
    }

    .detail-status {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .detail-status--active {
        background: rgba(63, 125, 88, 0.12);
        color: #3F7D58;
    }

    .detail-status--inactive {
        background: rgba(180, 72, 60, 0.12);
        color: #B4483C;
    }

    .details-actions {
        margin-top: 1.5rem;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.55rem 1.15rem;
        background: #FFFFFF;
        border: 1px solid #DCD7CB;
        border-radius: 4px;
        color: var(--slate);
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

        .btn-back:hover {
            background: var(--parchment);
            border-color: #C9C2B4;
            color: var(--ink);
        }

    @@media (max-width: 600px) {
        .details-page {
            margin: 1.25rem auto;
            padding: 0 1rem;
        }

        .details-heading {
            font-size: 1.6rem;
            margin-bottom: 1.25rem;
        }

        .details-body {
            padding: 1.25rem;
        }

        .detail-row {
            display: block;
            padding: 0.8rem 0;
        }

        .detail-label {
            display: block;
            margin-bottom: 0.3rem;
        }

        .detail-value {
            display: block;
        }

        .details-actions {
            margin-top: 1.25rem;
        }

        .btn-back {
            width: 100%;
        }
    }
</style>

<div class="details-page">

    <h2 class="details-heading">Student Details</h2>

    <div class="details-card">

        <div class="details-body">

            <div class="detail-row">
                <span class="detail-label">Student ID:</span>
                <span class="detail-value">@Model.StudentId</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Name:</span>
                <span class="detail-value">@Model.FullName</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Email:</span>
                <span class="detail-value">@Model.Email</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Mobile:</span>
                <span class="detail-value">@Model.Mobile</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Department:</span>
                <span class="detail-value">@Model.Department</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Course:</span>
                <span class="detail-value">@Model.Course</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Status:</span>
                <span class="detail-value">
                    @if (Model.Status == "Active")
                    {
                        <span class="detail-status detail-status--active">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="detail-status detail-status--inactive">
                            Inactive
                        </span>
                    }
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Created:</span>
                <span class="detail-value">@Model.CreatedAt</span>
            </div>

        </div>

    </div>

    <div class="details-actions">
        <a asp-action="Index" class="btn-back">
            Back
        </a>
    </div>

</div>

