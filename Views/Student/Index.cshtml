@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
}

<style>
    .page-heading {
        font-family: 'Source Serif 4', Georgia, serif;
        font-weight: 700;
        color: var(--ink);
    }

    .btn-brass {
        background: var(--ink);
        border: 1px solid var(--ink);
        color: #FFFFFF;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        border-radius: 4px;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

        .btn-brass:hover {
            background: var(--brass);
            border-color: var(--brass);
            color: #FFFFFF;
        }

    .search-form {
        max-width: 480px;
    }

        .search-form .form-control {
            border: 1px solid #E7E2D6;
            border-right: none;
            padding: 0.55rem 0.9rem;
        }

            .search-form .form-control:focus {
                box-shadow: none;
                border-color: var(--brass);
            }

        .search-form .btn-search {
            background: #FFFFFF;
            border: 1px solid #E7E2D6;
            border-left: none;
            color: var(--slate);
            font-weight: 500;
            padding: 0.55rem 1.1rem;
        }

            .search-form .btn-search:hover {
                background: var(--parchment);
                color: var(--ink);
            }

    .roster-card {
        background: #FFFFFF;
        border: 1px solid #E7E2D6;
        border-radius: 6px;
    }

    .roster-table {
        margin-bottom: 0;
        table-layout: fixed;
        width: 100%;
        border-radius: 6px;
        overflow: hidden;
    }

        .roster-table thead th {
            background: var(--parchment);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--slate);
            border-bottom: 1px solid #E7E2D6;
            padding: 0.65rem 0.85rem;
        }

        .roster-table tbody td {
            font-size: 0.7rem;
            padding: 0.65rem 0.85rem;
            vertical-align: middle;
            color: var(--ink);
            border-color: #EFEBE1;
            overflow-wrap: break-word;
        }

    .status-pill {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .status-pill--active {
        background: rgba(63, 125, 88, 0.12);
        color: #3F7D58;
    }

    .status-pill--inactive {
        background: rgba(180, 72, 60, 0.12);
        color: #B4483C;
    }

    .row-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: nowrap;
    }

        .row-actions a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--slate);
            text-decoration: none;
        }

            .row-actions a:hover {
                color: var(--ink);
                text-decoration: underline;
            }

            .row-actions a.action-delete {
                color: #B4483C;
            }

                .row-actions a.action-delete:hover {
                    color: #8F3830;
                }
</style>

<div class="container-fluid px-4 mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-heading mb-0">Student List</h2>

        <a asp-action="Create" class="btn-brass">
            Add Student
        </a>
    </div>

    <form method="get" class="search-form mb-4">
        <div class="input-group">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by ID, Name or Email" />

            <button type="submit" class="btn btn-search">
                Search
            </button>
        </div>
    </form>

    <div class="roster-card">
        <table class="table roster-table mb-0">
            <colgroup>
                <col style="width: 8%;">
                <col style="width: 14%;">
                <col style="width: 17%;">
                <col style="width: 10%;">
                <col style="width: 11%;">
                <col style="width: 11%;">
                <col style="width: 9%;">
                <col style="width: 20%;">
            </colgroup>
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Department</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentId</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.Mobile</td>
                        <td>@student.Department</td>
                        <td>@student.Course</td>

                        <td>
                            @if (student.Status == "Active")
                            {
                                <span class="status-pill status-pill--active">Active</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--inactive">Inactive</span>
                            }
                        </td>

                        <td>
                            <div class="row-actions">
                                <a asp-action="Details" asp-route-id="@student.Id">Details</a>
                                <a asp-action="Edit" asp-route-id="@student.Id">Edit</a>
                                <a asp-action="Delete" asp-route-id="@student.Id" class="action-delete">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div> *@













@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
}

<style>
    .students-page {
        width: 100%;
        padding: 2rem 2.5rem;
    }

    .students-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .page-heading {
        margin: 0;
        font-family: 'Source Serif 4', Georgia, serif;
        font-weight: 700;
        color: var(--ink);
    }

    .btn-brass {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--ink);
        border: 1px solid var(--ink);
        color: #FFFFFF;
        font-weight: 500;
        padding: 0.5rem 1.1rem;
        border-radius: 4px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

        .btn-brass:hover {
            background: var(--brass);
            border-color: var(--brass);
            color: #FFFFFF;
        }

    /* Search */

    .search-form {
        width: 100%;
        max-width: 480px;
        margin-bottom: 1.5rem;
    }

    .search-group {
        display: flex;
        width: 100%;
    }

    .search-input {
        flex: 1;
        min-width: 0;
        background: #FFFFFF;
        border: 1px solid #E7E2D6;
        border-right: none;
        padding: 0.55rem 0.9rem;
        font-family: inherit;
        font-size: 0.9rem;
        color: var(--ink);
        outline: none;
    }

        .search-input:focus {
            border-color: var(--brass);
        }

        .search-input::placeholder {
            color: #8A877F;
        }

    .btn-search {
        background: #FFFFFF;
        border: 1px solid #E7E2D6;
        border-left: none;
        color: var(--slate);
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.55rem 1.1rem;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

        .btn-search:hover {
            background: var(--parchment);
            color: var(--ink);
        }

    /* Table */

    .roster-card {
        width: 100%;
        background: #FFFFFF;
        border: 1px solid #E7E2D6;
        border-radius: 6px;
        overflow-x: auto;
    }

    .roster-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .roster-table thead th {
            background: var(--parchment);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--slate);
            text-align: left;
            border-bottom: 1px solid #E7E2D6;
            padding: 0.65rem 0.85rem;
        }

        .roster-table tbody td {
            font-size: 0.7rem;
            padding: 0.65rem 0.85rem;
            vertical-align: middle;
            text-align: left;
            color: var(--ink);
            border-bottom: 1px solid #EFEBE1;
            overflow-wrap: break-word;
        }

        .roster-table tbody tr:last-child td {
            border-bottom: none;
        }

        .roster-table tbody tr:hover {
            background: #FCFBF8;
        }

    /* Status */

    .status-pill {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 3px;
        font-size: 0.8rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .status-pill--active {
        background: rgba(63, 125, 88, 0.12);
        color: #3F7D58;
    }

    .status-pill--inactive {
        background: rgba(180, 72, 60, 0.12);
        color: #B4483C;
    }

    /* Actions */

    .row-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: nowrap;
    }

        .row-actions a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--slate);
            text-decoration: none;
            white-space: nowrap;
        }

            .row-actions a:hover {
                color: var(--ink);
                text-decoration: underline;
            }

            .row-actions a.action-delete {
                color: #B4483C;
            }

                .row-actions a.action-delete:hover {
                    color: #8F3830;
                }

    /* Responsive */

    @@media (max-width: 768px) {
        .students-page {
            padding: 1.5rem;
        }

        .students-header {
            gap: 1rem;
        }

        .page-heading {
            font-size: 1.5rem;
        }

        .btn-brass {
            padding: 0.45rem 0.85rem;
            font-size: 0.85rem;
        }

        .search-form {
            max-width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .students-page {
            padding: 1rem;
        }

        .students-header {
            align-items: flex-start;
        }

        .page-heading {
            font-size: 1.35rem;
        }

        .btn-brass {
            font-size: 0.8rem;
            padding: 0.4rem 0.7rem;
        }
    }
</style>

<div class="students-page">

    <div class="students-header">
        <h2 class="page-heading">Student List</h2>

        <a asp-action="Create" class="btn-brass">
            Add Student
        </a>
    </div>

    <form method="get" class="search-form">
        <div class="search-group">

            <input type="text"
                   name="searchString"
                   class="search-input"
                   placeholder="Search by ID, Name or Email" />

            <button type="submit" class="btn-search">
                Search
            </button>

        </div>
    </form>

    <div class="roster-card">

        <table class="roster-table">

            <colgroup>
                <col style="width: 8%;">
                <col style="width: 14%;">
                <col style="width: 17%;">
                <col style="width: 10%;">
                <col style="width: 11%;">
                <col style="width: 11%;">
                <col style="width: 9%;">
                <col style="width: 20%;">
            </colgroup>

            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Department</th>
                    <th>Course</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentId</td>
                        <td>@student.FullName</td>
                        <td>@student.Email</td>
                        <td>@student.Mobile</td>
                        <td>@student.Department</td>
                        <td>@student.Course</td>

                        <td>
                            @if (student.Status == "Active")
                            {
                                <span class="status-pill status-pill--active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-pill status-pill--inactive">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            <div class="row-actions">
                                <a asp-action="Details"
                                   asp-route-id="@student.Id">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@student.Id">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@student.Id"
                                   class="action-delete">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>